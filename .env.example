# Copy to .env and adjust values: cp .env.example .env

# ---- Application ----
APP_NAME=quickbase-interview-backend
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_PORT=5000

# ---- Auth (JWT) ----
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# JSON login body keeps access_token while true. The httpOnly qb_session cookie is always set.
AUTH_RETURN_TOKEN_IN_BODY=true
# Comma-separated peers allowed to set the client IP via X-Forwarded-For. Empty ignores the header.
TRUSTED_PROXIES=
# Login: 10 per 15 minutes for each IP+email, and 50 per 15 minutes for each IP.
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP=50
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
# Shared by chat send and approve.
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_ORGANIZATION_PER_MINUTE=200

# ---- LLM (Gemini via google-genai) ----
# Free key: https://aistudio.google.com/apikey. Empty = /api/v1/llm/* answers 503, the rest of the app works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated, tried in order when the main model is overloaded (503/429) or hangs. Empty disables fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Per attempt: no first chunk within this time = model treated as overloaded -> retry / fall back
GEMINI_FIRST_CHUNK_TIMEOUT_SECONDS=20
# Whole request once streaming; also sent to Google as the server-side generation deadline
GEMINI_REQUEST_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=1
GEMINI_TEMPERATURE=0.2
# gemini uses the key above. fake replays YAML scripts and never calls Gemini.
# APP_ENV=production refuses to boot when LLM_PROVIDER=fake.
# CI chat E2E forces fake + read_path.yaml. Local runs use Gemini.
LLM_PROVIDER=gemini
LLM_FAKE_SCRIPT_PATH=tests/fixtures/llm_scripts/read_path.yaml
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_HISTORY_MAX_MESSAGES=40

# ---- PostgreSQL ----
POSTGRES_USER=quickbase
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quickbase
# Host/port used when running the backend outside Docker (compose overrides to db:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the DB container is published on
POSTGRES_EXPOSED_PORT=5432
# API role created by Alembic. Not a superuser and not BYPASSRLS. Migrations keep POSTGRES_USER.
POSTGRES_APP_USER=qai_app
POSTGRES_APP_PASSWORD=qai-app-password
# Dev seed password for lead@ / op1@ / op2@ on excellence.qai.local and quantum.qai.local.
# Ignored when APP_ENV=production.
SEED_USER_PASSWORD=admin123

# ---- Frontend (Nuxt) ----
FRONTEND_PORT=3000
# Browser-reachable backend URL
NUXT_PUBLIC_API_BASE=http://localhost:5000
