# Copy to .env and adjust values: cp .env.example .env

# ---- Application ----
APP_NAME=quickbase-interview-backend
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_PORT=5000

# ---- Auth (JWT) ----
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- PostgreSQL ----
POSTGRES_USER=quickbase
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quickbase
# Host/port used when running the backend outside Docker (compose overrides to db:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the DB container is published on
POSTGRES_EXPOSED_PORT=5432

# ---- Frontend (Nuxt) ----
FRONTEND_PORT=3000
# Browser-reachable backend URL
NUXT_PUBLIC_API_BASE=http://localhost:5000
