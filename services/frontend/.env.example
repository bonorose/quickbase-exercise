# Used when running `npm run dev` directly on the host (docker compose reads the root .env instead).
# The SPA calls the API from the browser, so this must be a URL reachable from the browser.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:5000
NUXT_PUBLIC_API_PREFIX=/api/v1
# Set true to run the SPA against MSW fixtures (no backend). Must stay false for generate/prod.
NUXT_PUBLIC_USE_MOCKS=false
